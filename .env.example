# Supabase — required for production authentication and database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Map tiles — CARTO dark_all works without a key (free, no account required)
# Optional: set VITE_MAPTILER_KEY for higher rate limits
VITE_MAPTILER_KEY=

# Demo Mode — set to "true" to enable demo accounts (local dev only)
# In production, must be set to "false"
VITE_DEMO_MODE=false

# OpenSky Network API credentials (optional)
# Setting these increases the daily rate limit from 400 to 4000 requests/day.
# Without them, the 45s polling interval may exhaust the anonymous limit.
VITE_OPENSKY_USERNAME=
VITE_OPENSKY_PASSWORD=
